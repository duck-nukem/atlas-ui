{
  "name": "atlas-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/elements/index.d.ts",
      "import": "./dist/elements.js"
    },
    "./atlas-ui.css": "./dist/atlas-ui.css",
    "./icons.svg": "./dist/icons.svg",
    "./fonts.css": "./dist/fonts.css",
    "./interest.js": {
      "types": "./dist/interest.d.ts",
      "import": "./dist/interest.js"
    },
    "./elements.js": {
      "types": "./dist/elements/index.d.ts",
      "import": "./dist/elements.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "icons": "node scripts/build-icons.ts",
    "build": "rm -rf dist && vite build && tsc -p tsconfig.build.json && node scripts/build-css.ts && cp src/icons/icons.svg dist/icons.svg",
    "prepare": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --max-warnings 0 --report-unused-disable-directives && stylelint 'src/css/**/*.css' && node scripts/check-css-literals.ts",
    "test": "vitest run --config vitest.ci.config.ts",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm run test && prettier --check ."
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/html-vite": "^10.6.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@vitest/browser-playwright": "^5.0.3",
    "jsdom": "^30.1.1",
    "lucide-static": "^1.51.0",
    "oxlint": "1.85",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.1",
    "stylelint": "^17.16.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
