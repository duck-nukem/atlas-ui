{
  "name": "atlas-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./atlas-ui.css": "./dist/atlas-ui.css",
    "./icons.svg": "./dist/icons.svg"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && vite build && tsc -p tsconfig.build.json && node scripts/build-css.ts && cp src/icons/icons.svg dist/icons.svg",
    "prepare": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --max-warnings 0 --report-unused-disable-directives && stylelint 'src/css/**/*.css'",
    "test": "vitest run",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm run test && prettier --check ."
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.3",
    "jsdom": "^30.1.1",
    "lightningcss": "^1.33.0",
    "lucide-static": "^1.51.0",
    "oxlint": "1.85",
    "playwright": "^1.63.0",
    "preact": "^11.0.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
