{
  "rules": {
    "selector-class-pattern": "^(ui-[a-z0-9-]+|dark)$",
    "block-no-empty": true,
    "declaration-block-no-duplicate-properties": true
  },
  "overrides": [
    {
      "files": ["src/css/components/**/*.css"],
      "rules": {
        "color-no-hex": true,
        "color-named": "never",
        "function-disallowed-list": [
          "rgb",
          "rgba",
          "hsl",
          "hsla",
          "oklch",
          "oklab",
          "lab",
          "lch"
        ],
        "declaration-property-value-disallowed-list": {
          "font-weight": ["/^\\d+$/", "bold", "normal"],
          "font-family": ["/.*/"],
          "font-size": ["/\\d(px|rem|em)$/"]
        }
      }
    }
  ]
}
